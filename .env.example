# Copy to .env and fill in. Never commit .env.
# Values for SHOPIFY_API_KEY / SHOPIFY_API_SECRET come from your Partner app;
# the Shopify CLI (`shopify app dev`) injects most of these automatically in dev.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_orders,write_draft_orders,read_companies,read_payment_terms,read_inventory
SHOPIFY_APP_URL=http://localhost:3000

# Secret used to sign the buyer portal session cookie. Set a long random value
# in production (the app refuses to boot in production without it).
SESSION_SECRET=

# Claude API key for the AI Magic Order Pad (S12) and the AI Quote Assistant (F1).
# Only needed for the AI features; the deterministic quick-order pad works without it.
ANTHROPIC_API_KEY=

# Feature flag for the AI Quote Assistant (F1, Growth-only). Set to "true" to
# turn it on (dark-launched off by default). The UI + action are inert unless set.
MANNON_FF_AI_QUOTE=

# Analytics + errors (S14). All optional — the app runs fine with these unset
# (analytics and error reporting simply no-op). See /docs/metrics.md.
# PostHog project API key for the AARRR funnel (server-side capture).
POSTHOG_API_KEY=
# PostHog host. Defaults to https://us.i.posthog.com when unset.
POSTHOG_HOST=
# Sentry DSN for internal error reporting.
SENTRY_DSN=

# Postgres connection string (Prisma). Example for local docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mannon?schema=public
