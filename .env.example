# Copy to .env and fill in. Never commit .env.
# Values for SHOPIFY_API_KEY / SHOPIFY_API_SECRET come from your Partner app;
# the Shopify CLI (`shopify app dev`) injects most of these automatically in dev.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_orders,write_draft_orders,read_companies,read_payment_terms,read_inventory
SHOPIFY_APP_URL=http://localhost:3000

# Secret used to sign the buyer portal session cookie. Set a long random value
# in production (the app refuses to boot in production without it).
SESSION_SECRET=

# Claude API key for the AI Magic Order Pad (S12) and the AI Quote Assistant (F1).
# Only needed for the AI features; the deterministic quick-order pad works without it.
ANTHROPIC_API_KEY=

# Feature flag for the AI Quote Assistant (F1, Growth-only). Set to "true" to
# turn it on (dark-launched off by default). The UI + action are inert unless set.
MANNON_FF_AI_QUOTE=

# Feature flag for Net Terms + Credit Management (F2). Set to "true" to turn on
# invoices, credit checks, the aging dashboard, and reminders.
MANNON_FF_CREDIT=

# Feature flag for Customer Price Lists (F3). Set to "true" to turn on price
# lists, volume breaks, CSV, and the buyer "you save X%" pricing.
MANNON_FF_PRICELISTS=

# Feature flag for the enhanced bulk Order Pad (F4). Set to "true" to turn on
# type-ahead search, saved lists, and CSV upload. Basic paste stays on regardless.
MANNON_FF_ORDERPAD=

# Feature flag for Company Accounts (F5). Set to "true" to turn on the Team tab,
# member roles, and spending approvals.
MANNON_FF_COMPANY_ACCOUNTS=

# Feature flag for Wholesale Registration (F6). Set to "true" to turn on the
# public apply form, the approval queue, and auto-approval rules.
MANNON_FF_WHOLESALE_REG=

# Feature flag for Quote Analytics (F7, Growth). Set to "true" to turn on the
# negotiation-analytics dashboard, the rollup cron, and the weekly digest.
MANNON_FF_QUOTE_ANALYTICS=

# Feature flag for automated Follow-ups (F8). Set to "true" to turn on quote
# expiry, the reminder cadence, and the follow-up scheduler.
MANNON_FF_FOLLOWUPS=

# Feature flag for MOQ, Order Minimums & Pack/Case-Size Rules (F9). Set to "true"
# to turn on order-rule enforcement in the cart, order pad, submit, and quote→order.
MANNON_FF_MOQ=

# Feature flag for Accounting Sync (F10, Growth). Set to "true" to turn on the
# QuickBooks Online / Xero connect flow, invoice sync jobs, and the sync log.
MANNON_FF_ACCOUNTING_SYNC=

# Feature flag for Custom Catalogs (F11). Set to "true" to turn on per-customer
# product visibility (catalogs, assignments, preview). When off, every buyer sees
# the full catalog exactly as before.
MANNON_FF_CUSTOM_CATALOGS=

# Feature flag for the Sales-Rep Portal (F12, Growth). Set to "true" to turn on
# rep invites, the scoped /rep portal, order-on-behalf, and the rep leaderboard.
MANNON_FF_REP_PORTAL=

# Feature flag for Flexible Payments (F13, Growth). Set to "true" to turn on
# deposits, installment plans, and pay-by-link. All capture runs through Shopify
# checkout — Mannon never stores card data. Reuses CRON_SECRET for reminders.
MANNON_FF_FLEX_PAY=

# Feature flag for Tax Exemption & VAT/GST (F14). Set to "true" to turn on tax
# profiles, certificate workflow, ID validation, per-region rules, and compliant
# invoice numbering. When off, orders are taxed by Shopify exactly as before.
# Reuses CRON_SECRET for certificate-expiry reminders.
MANNON_FF_TAX_VAT=

# Feature flag for ERP / Inventory Sync (F15, Growth). Set to "true" to turn on
# ERP connections, inbound stock + the oversell guard, and outbound order export.
# ERP credentials are encrypted with MANNON_ENCRYPTION_KEY (see F10). Reuses
# CRON_SECRET for the outbound export worker.
MANNON_FF_ERP_SYNC=

# Feature flag for Multi-Currency & Multi-Language (F16). Set to "true" to turn on
# the buyer locale switch (Arabic RTL), per-buyer currency display, FX rate-locking
# on quotes, and localized emails. When off, everyone sees the store default.
MANNON_FF_I18N=

# Feature flag for the storefront "Request a Quote" widget (F17). Set to "true" to
# turn on the public config + submission API and the admin requests inbox. The
# theme app block also checks the merchant's per-shop enable toggle before showing.
# MANNON_MERCHANT_ALERT_EMAIL (see F10) receives new-request notices.
MANNON_FF_QUOTE_WIDGET=

# F10 — AES-256-GCM key for encrypting accounting OAuth tokens at rest. A 32-byte
# key (hex or base64) is ideal; any other value is hashed to 32 bytes. REQUIRED to
# store a connection — accounting sync is inert without it. Never commit a real key.
MANNON_ENCRYPTION_KEY=

# F10 — OAuth app credentials per provider (standard redirect flow; never pasted
# by the merchant). Create these in each provider's developer portal and set the
# redirect URI to https://<app-url>/accounting/callback/<qbo|xero>.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# F10 — where the accounting sync-failure digest is emailed (merchant ops inbox).
# Optional; the digest no-ops if unset (failures still show in the in-app log).
MANNON_MERCHANT_ALERT_EMAIL=

# Shared secret for the reminder cron route (/internal/cron/reminders). The
# scheduler must send it as the `x-cron-secret` header. Unset → route returns 503.
CRON_SECRET=

# From-address for transactional email (invoices + reminders). Until this is set,
# the mailer no-ops (PaymentReminder rows are still written). Wire a transport in
# app/services/mailer.server.ts when provisioning real delivery.
MANNON_MAIL_FROM=

# Analytics + errors (S14). All optional — the app runs fine with these unset
# (analytics and error reporting simply no-op). See /docs/metrics.md.
# PostHog project API key for the AARRR funnel (server-side capture).
POSTHOG_API_KEY=
# PostHog host. Defaults to https://us.i.posthog.com when unset.
POSTHOG_HOST=
# Sentry DSN for internal error reporting.
SENTRY_DSN=

# Postgres connection string (Prisma). Example for local docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mannon?schema=public
