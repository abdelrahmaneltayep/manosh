# Copy to .env and fill in. Never commit .env.
# Values for SHOPIFY_API_KEY / SHOPIFY_API_SECRET come from your Partner app;
# the Shopify CLI (`shopify app dev`) injects most of these automatically in dev.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_orders,write_draft_orders,read_companies,read_payment_terms
SHOPIFY_APP_URL=http://localhost:3000

# Secret used to sign the buyer portal session cookie. Set a long random value
# in production (the app refuses to boot in production without it).
SESSION_SECRET=

# Claude API key for the AI Magic Order Pad (S12). Only needed for the AI paste
# feature; the deterministic quick-order pad works without it.
ANTHROPIC_API_KEY=

# Postgres connection string (Prisma). Example for local docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mannon?schema=public
