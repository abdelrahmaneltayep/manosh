// Mannon Prisma schema — see /docs/data-model.md for the authoritative spec.
// Guardrail #6: Event is append-only. It is written ONLY through
// app/services/events.server.ts (insert-only). There is no update/delete path
// for events anywhere in application code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify OAuth session storage. Shape dictated by the session-storage-prisma
// adapter; survives reinstall. Do not hand-edit column names without matching
// the adapter's expectations.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                    String                 @id @default(cuid())
  shopifyDomain         String                 @unique // e.g. acme.myshopify.com
  plan                  Plan                   @default(TRIAL)
  trialEndsAt           DateTime?
  autoApproveTolerance  Float                  @default(0) // reorder auto-convert tolerance, fraction (0.05 = 5%)
  quoteExpiryDays       Int                    @default(14) // default quote lifetime
  magicLinkExpiryDays   Int                    @default(7) // how long a buyer magic link stays valid
  minMarginPct          Float                  @default(0.15) // AI Quote Assistant floor margin, fraction (0.15 = 15%)
  defaultTermsDays      Int                    @default(30) // F2: default net-terms days for new invoices
  emailTemplates        Json? // F2: editable invoice/reminder email templates (keyed by template id)
  defaultDepositPct     Float? // F13: default deposit policy (fraction, e.g. 0.30 = 30%); null = none
  defaultTaxRate        Float? // F14: single default tax rate (fraction, e.g. 0.15 = 15%); reference/display
  invoiceSeq            Int                    @default(0) // F14: compliant invoice number sequence (Growth)
  defaultLocale         String                 @default("en") // F16: store default locale
  supportedLocales      Json? // F16: enabled locales, e.g. ["en","ar"]
  supportedCurrencies   Json? // F16: enabled currencies (besides the store default), e.g. ["SAR"]
  i18nStrings           Json? // F16: custom UI string overrides, keyed by locale (Growth)
  quoteWidgetEnabled    Boolean                @default(false) // F17: storefront Request-a-Quote widget on/off
  quoteWidgetLabel      String? // F17: button label (falls back to a default)
  quoteWidgetGated      Boolean                @default(false) // F17: only approved wholesale buyers see it (Growth)
  quoteWidgetCartEnabled Boolean               @default(false) // F17: cart-level requests (Growth)
  quoteWidgetCustomFields Json? // F17: extra form fields (Growth)
  weeklyDigest          Boolean                @default(false) // F7: opt-in "your week in quotes" email (Growth)
  timezone              String? // F8: IANA tz for quiet-hours-safe follow-up sends
  installedAt           DateTime               @default(now())
  companies             Company[]
  events                Event[]
  staffSeats            StaffSeat[]
  variantCosts          VariantCost[]
  priceLists            PriceList[]
  priceListTags         PriceListTag[]
  wholesaleForms        WholesaleForm[]
  wholesaleApplications WholesaleApplication[]
  quoteMetrics          QuoteMetricDaily[]
  followupPolicy        FollowupPolicy?
  orderRules            OrderRule[]
  accountingConnections AccountingConnection[]
  accountingSyncLogs    AccountingSyncLog[]
  accountingMap         AccountingMap?
  catalogs              Catalog[]
  salesReps             SalesRep[]
  taxRuleOverrides      TaxRuleOverride[]
  erpConnection         ErpConnection?
  erpSyncLogs           ErpSyncLog[]
  stockOverrides        StockOverride[]
  currencyRates         CurrencyRate[]
  quoteRequests         QuoteRequest[]
  quoteForms            QuoteForm[]
  priceVisibilityRules  PriceVisibilityRule[]
  publicCatalogs        PublicCatalog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// F17 — a lead captured by the storefront "Request a Quote" widget (theme app
// extension). Converts to a real F1 Quote in one click. Anonymous input is
// validated + escaped; hidden-catalog SKUs (F11) are never exposed.
model QuoteRequest {
  id               String              @id @default(cuid())
  shopId           String
  shop             Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  source           QuoteRequestSource  @default(PDP)
  email            String
  companyName      String?
  lines            Json // [{ variantId?, sku?, title?, quantity }]
  note             String?
  customFields     Json? // extra fields (Growth)
  status           QuoteRequestStatus  @default(NEW)
  convertedQuoteId String?             @unique // set on conversion → Quote.id
  convertedQuote   Quote?              @relation("QuoteFromRequest", fields: [convertedQuoteId], references: [id], onDelete: SetNull)
  formId           String? // F24.1: the custom QuoteForm this submission used
  form             QuoteForm?          @relation("QuoteRequestForm", fields: [formId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([shopId, status])
}

// F24.1 — a merchant-built storefront quote form (custom fields per surface).
// The theme app extension renders the active form for its surface; the merchant
// builds it in embedded Polaris. `fields` is the ordered field schema (see
// app/lib/quote-form.ts). Basic builder is on every plan; advanced controls
// (conditional logic, multiple forms) are Growth (F24 PR-8b).
model QuoteForm {
  id        String           @id @default(cuid())
  shopId    String
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  surface   QuoteFormSurface @default(PRODUCT)
  fields    Json // [{ key, type, label, required, placeholder?, help?, options?, showIf? }]
  active    Boolean          @default(true)
  successMode  QuoteFormSuccessMode @default(MESSAGE) // F24.4 post-submission control
  successValue String? // the thank-you message (MESSAGE) or redirect URL (REDIRECT)
  translations Json? // F24.5 per-locale overrides: { "<locale>": { fields: {key:{label?,placeholder?,help?}}, successValue? } }
  requests  QuoteRequest[]   @relation("QuoteRequestForm")
  quotes    Quote[]          @relation("QuoteForm")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([shopId, active])
}

enum QuoteFormSurface {
  PRODUCT
  COLLECTION
  CART
  PAGE
}

enum QuoteFormSuccessMode {
  MESSAGE
  REDIRECT
}

// F24.2 — storefront price / Add-to-Cart visibility rule. Hide price and/or the
// ATC button and swap in a "Request a Quote" CTA, scoped by audience or catalog.
// Evaluated in the theme app extension; the decision NEVER carries a price.
model PriceVisibilityRule {
  id        String               @id @default(cuid())
  shopId    String
  shop      Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scope     PriceVisibilityScope @default(ALL)
  scopeRef  String? // tag value / product gid / collection gid for the scope
  hidePrice Boolean              @default(true)
  hideAtc   Boolean              @default(false)
  ctaLabel  String               @default("Request a Quote")
  active    Boolean              @default(true)
  priority  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([shopId, active, priority])
}

enum PriceVisibilityScope {
  ALL
  LOGGED_OUT
  CUSTOMER_TAG
  PRODUCT
  COLLECTION
}

// F19 — a shareable public/semi-public wholesale catalog (Faire-style). Renders
// a chosen F11 Catalog as a branded public page. Prices are hidden by default;
// hidden SKUs never leak (the page reads through the same F11 visibility as the
// portal). A "Request wholesale access" CTA creates a CatalogLead → F6 → F11.
// Growth-only; dark-launched behind MANNON_FF_CATALOG_SHARE.
model PublicCatalog {
  id         String                  @id @default(cuid())
  shopId     String
  shop       Shop                    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  catalogId  String // the F11 Catalog whose products are published
  catalog    Catalog                 @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  slug       String // public URL segment, unique per shop
  title      String
  visibility PublicCatalogVisibility @default(LINK) // LINK = unlisted; LISTED = in the discovery index
  showPrices PublicCatalogPrices     @default(HIDDEN)
  status     PublicCatalogStatus     @default(DRAFT)
  leads      CatalogLead[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([visibility, status])
}

enum PublicCatalogVisibility {
  LINK // shareable link only (unlisted)
  LISTED // opt-in to the in-app Mannon discovery index
}

enum PublicCatalogPrices {
  HIDDEN // never show prices publicly
  AFTER_APPROVAL // prices unlock in the portal once the buyer is approved
  PUBLIC // show reference prices on the public page
}

enum PublicCatalogStatus {
  DRAFT // not yet published; public page 404s
  LIVE // published; public page + (if LISTED) discovery index
}

// F19 — a wholesale-access request captured from a public catalog page. Approving
// it runs the F6 provisioning pipeline (Company + magic-link buyer) and assigns
// the catalog (F11) so the new buyer sees their real prices. Spam-guarded.
model CatalogLead {
  id              String          @id @default(cuid())
  publicCatalogId String
  publicCatalog   PublicCatalog   @relation(fields: [publicCatalogId], references: [id], onDelete: Cascade)
  email           String
  companyName     String?
  message         String?
  status          CatalogLeadStatus @default(NEW)
  createdAt       DateTime        @default(now())

  @@index([publicCatalogId, status])
}

enum CatalogLeadStatus {
  NEW
  APPROVED
  DECLINED
}

// F18 — a buyer's Web Push subscription (installable PWA). Opt-in only; stores
// just the endpoint + keys needed to deliver a "time to reorder?" nudge (Growth).
model PushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  member    Buyer    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json // { p256dh, auth }
  createdAt DateTime @default(now())

  @@index([memberId])
}

// F18 — a saved "usual order" bundle for one-tap reorder. Capped per plan
// (Starter 1 / Growth unlimited).
model ReorderShortcut {
  id        String   @id @default(cuid())
  memberId  String
  member    Buyer    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String
  lines     Json // [{ variantId, quantity }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
}

enum QuoteRequestSource {
  PDP
  CART
  WIDGET
}

enum QuoteRequestStatus {
  NEW
  CONVERTED
  DECLINED
}

// F16 — an FX rate from `base` to `quote`. `source` = live Shopify Markets rate
// or a merchant-set fixed rate (contract pricing). A quote locks its rate at
// issue time (Quote.displayRate) so a counter-offer never drifts with FX.
model CurrencyRate {
  id        String     @id @default(cuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  base      String // ISO 4217, e.g. "USD"
  quote     String // ISO 4217, e.g. "SAR"
  rate      Decimal    @db.Decimal(18, 8)
  source    RateSource @default(MANUAL)
  updatedAt DateTime   @updatedAt

  @@unique([shopId, base, quote])
  @@index([shopId])
}

// F16 — a buyer's (company or member) locale + currency preference. Resolution
// order: member > company > store default.
model LocalePreference {
  id        String   @id @default(cuid())
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberId  String?  @unique
  member    Buyer?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  locale    String
  currency  String
  updatedAt DateTime @updatedAt
}

// F16 — an optional per-currency price override for an F3 price-list entry, so a
// merchant can set exact contract prices per currency (no FX math). Growth.
model PriceListCurrencyOverride {
  id          String         @id @default(cuid())
  entryId     String
  entry       PriceListEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  currency    String
  price       Decimal        @db.Decimal(18, 4)

  @@unique([entryId, currency])
  @@index([entryId])
}

enum RateSource {
  SHOPIFY
  MANUAL
}

// F15 — a store's link to its ERP/WMS (webhook, SFTP, NetSuite, or custom).
// Credentials are AES-256-GCM encrypted at rest (app/lib/crypto) and never
// logged. `sourceOfTruth` decides who wins on a stock conflict. Growth-only.
model ErpConnection {
  id              String     @id @default(cuid())
  shopId          String     @unique
  shop            Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind            ErpKind
  endpoint        String? // non-secret: outbound webhook URL / SFTP host / connector base
  config          Json       @default("{}") // non-secret settings + field mapping
  secretEncrypted String? // encrypted credentials (token / password / inbound secret)
  sandbox         Boolean    @default(true) // dry-run / sandbox mode
  sourceOfTruth   StockSource @default(SHOPIFY)
  status          ErpStatus  @default(CONNECTED)
  lastSyncAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// F15 — one row per sync attempt, in either direction. Outbound order exports
// are deduped in code by (shop, direction, localId); `attempts` drives backoff.
model ErpSyncLog {
  id        String        @id @default(cuid())
  shopId    String
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  direction SyncDirection
  entity    String // "stock" | "order"
  localId   String? // Mannon Quote.id (order) or variantId (stock)
  remoteId  String? // ERP-side id once exported
  status    SyncStatus    @default(PENDING)
  attempts  Int           @default(0)
  error     String? // last error (never contains credentials)
  digested  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([shopId, status])
  @@index([shopId, direction])
}

// F15 — the Mannon stock cache used by the oversell guard, MOQ (F9), and
// catalogs (F11). One row per variant; `source` records who last set it.
model StockOverride {
  id        String      @id @default(cuid())
  shopId    String
  shop      Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId String
  source    StockSource
  qty       Int
  updatedAt DateTime    @updatedAt

  @@unique([shopId, variantId])
  @@index([shopId])
}

enum ErpKind {
  WEBHOOK
  SFTP
  NETSUITE
  CUSTOM
}

enum ErpStatus {
  CONNECTED
  ERROR
}

enum SyncDirection {
  INBOUND_STOCK
  OUTBOUND_ORDER
}

enum StockSource {
  SHOPIFY
  ERP
}

// F14 — a company's tax profile: their tax id, whether they're exempt, and the
// verification state. Default-taxed until VERIFIED (guardrail): an unverified
// upload never auto-exempts. Certificate bytes are stored privately (in the DB,
// never a public URL) and downloadable only through an authenticated admin route.
model TaxProfile {
  id                   String        @id @default(cuid())
  companyId            String        @unique
  company              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxId                String?
  taxIdType            TaxIdType     @default(OTHER)
  exempt               Boolean       @default(false)
  status               TaxStatus     @default(UNVERIFIED)
  verifiedAt           DateTime?
  rejectedReason       String?
  certificateName      String?
  certificateType      String? // MIME type
  certificateData      Bytes? // private storage — never exposed via a public URL
  certificateExpiresAt DateTime? // time-limited certs → expiry reminders
  certExpiryRemindedAt DateTime? // idempotency guard for expiry reminder emails
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

// F14 — per-region tax rule override (Growth). Reference rate + a policy flag to
// treat a whole region as exempt by default. Mannon never COMPUTES tax — Shopify
// does; these drive the draft-order taxExempt flag + display, not a calculation.
model TaxRuleOverride {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  region          String // e.g. "SA", "AE", "EU", "US-CA"
  rate            Decimal? @db.Decimal(6, 4) // reference rate (fraction); display only
  exemptByDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shopId, region])
}

enum TaxIdType {
  VAT
  GST
  ABN
  EIN
  OTHER
}

enum TaxStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

// F12 — a merchant's sales rep. Authenticates via the same passwordless
// magic-link mechanism as buyers (token hashed at rest, guardrail #7), into a
// scoped rep portal that shows only their assigned companies. Growth-only.
model SalesRep {
  id                  String          @id @default(cuid())
  shopId              String
  shop                Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email               String
  name                String?
  status              RepStatus       @default(INVITED)
  magicTokenHash      String? // hash only, never raw
  magicTokenExpiresAt DateTime?
  invitedAt           DateTime?
  assignments         RepAssignment[]
  placedQuotes        Quote[]         @relation("QuotePlacedByRep")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([shopId, email])
  @@index([magicTokenHash])
}

// F12 — which companies a rep may see/act on. Strict isolation: a rep only ever
// sees companies with a row here.
model RepAssignment {
  id        String   @id @default(cuid())
  repId     String
  rep       SalesRep @relation(fields: [repId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([repId, companyId])
  @@index([companyId])
}

enum RepStatus {
  INVITED
  ACTIVE
}

// F11 — a custom product catalog: which SKUs a buyer/company/group may see.
// `visibility=ASSIGNED` is deny-by-default (only included items are visible);
// `visibility=ALL` shows everything except items explicitly flagged hidden.
model Catalog {
  id          String              @id @default(cuid())
  shopId      String
  shop        Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  isDefault   Boolean             @default(false)
  visibility  CatalogVisibility   @default(ASSIGNED)
  items       CatalogItem[]
  assignments CatalogAssignment[]
  publicCatalogs PublicCatalog[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([shopId])
}

// A product/variant membership within a catalog. `hidden=true` blocklists an
// item (used to hide a SKU inside an ALL catalog); otherwise it's an allow entry.
model CatalogItem {
  id        String   @id @default(cuid())
  catalogId String
  catalog   Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  productId String // gid://shopify/Product/...
  variantId String? // gid://shopify/ProductVariant/... (null = whole product)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([catalogId, productId, variantId])
  @@index([catalogId])
}

// Assign a catalog at member > company > group precedence. `customerGroupTag`
// reuses the F3 notion of a group (a Shopify customer tag / segment). Exactly
// one of the three targets is set per row.
model CatalogAssignment {
  id               String   @id @default(cuid())
  catalogId        String
  catalog          Catalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerGroupTag String?
  memberId         String?
  member           Buyer?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([catalogId])
  @@index([companyId])
  @@index([memberId])
  @@index([customerGroupTag])
}

enum CatalogVisibility {
  ALL
  ASSIGNED
}

// F10 — a store's OAuth link to an external accounting provider (QuickBooks
// Online or Xero). Tokens are AES-256-GCM encrypted at rest (app/lib/crypto)
// and NEVER logged. One connection per (shop, provider).
model AccountingConnection {
  id           String              @id @default(cuid())
  shopId       String
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider     AccountingProvider
  accessToken  String // encrypted
  refreshToken String // encrypted
  realmId      String? // QBO company id
  tenantId     String? // Xero tenant id
  expiresAt    DateTime? // access-token expiry (drives silent refresh)
  status       AccountingConnStatus @default(CONNECTED)
  sandbox      Boolean             @default(false) // test-mode toggle
  connectedAt  DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([shopId, provider])
}

// F10 — one row per entity we try to push to the provider. Idempotent: unique
// on (shop, provider, entity, localId) so a retry or double-checkout never
// double-posts. `attempts` drives capped backoff.
model AccountingSyncLog {
  id        String             @id @default(cuid())
  shopId    String
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  provider  AccountingProvider
  entity    SyncEntity
  localId   String // Mannon Invoice.id (or company/payment id)
  remoteId  String? // provider-side id once created
  status    SyncStatus         @default(PENDING)
  attempts  Int                @default(0)
  error     String? // last error message (never contains tokens/PII)
  digested  Boolean            @default(false) // included in a failure digest already
  createdAt DateTime           @default(now())
  syncedAt  DateTime?
  updatedAt DateTime           @updatedAt

  @@unique([shopId, provider, entity, localId])
  @@index([shopId, status])
}

// F10 — per-shop field mapping: Mannon tax classes → provider tax codes, the
// default income account, and how to match/create the provider customer.
model AccountingMap {
  id                    String                @id @default(cuid())
  shopId                String                @unique
  shop                  Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  taxCodeMap            Json                  @default("{}") // { "<mannon tax class>": "<provider tax code>" }
  accountMap            Json                  @default("{}") // { "income": "<account id>" }
  customerMatchStrategy CustomerMatchStrategy @default(EMAIL)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

enum AccountingProvider {
  QBO
  XERO
}

enum AccountingConnStatus {
  CONNECTED
  EXPIRED
  ERROR
}

enum SyncEntity {
  INVOICE
  PAYMENT
  CUSTOMER
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CustomerMatchStrategy {
  EMAIL
  NAME
}

// F9 — wholesale order controls: minimum order quantity, pack/case-size
// multiples, and order-value minimums. Scoped by specificity (product >
// customer-group > collection > store); the most specific matching rule wins.
model OrderRule {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  scope         RuleScope
  targetId      String? // variantId (PRODUCT), companyId (CUSTOMER_GROUP), collection gid (COLLECTION); null for STORE
  minQty        Int?
  packSize      Int?
  minOrderValue Decimal?  @db.Decimal(18, 4)
  priority      Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shopId, scope])
}

enum RuleScope {
  STORE
  COLLECTION
  PRODUCT
  CUSTOMER_GROUP
}

// F8 — store default follow-up policy (one per shop). Starter is clamped to a
// single manual reminder (PLAN_LIMITS.followupCadenceMax); Growth runs the full
// cadence.
model FollowupPolicy {
  id          String   @id @default(cuid())
  shopId      String   @unique
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  expiryDays  Int      @default(14)
  cadenceDays Int[] // days after submit to nudge, e.g. [3, 7, 12]
  maxNudges   Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// F7 — nightly rollup of negotiation metrics per shop per day. Derived from
// Quote + the append-only Event stream by the analytics cron; the dashboard also
// computes "today" live. One row per (shopId, date).
model QuoteMetricDaily {
  id                String   @id @default(cuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  quotesCreated     Int      @default(0)
  quotesWon         Int      @default(0)
  quotesLost        Int      @default(0)
  quotesExpired     Int      @default(0)
  quoteValueTotal   Decimal  @default(0) @db.Decimal(18, 4)
  discountPctAvg    Float    @default(0)
  timeToCloseHrsAvg Float    @default(0)
  createdAt         DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId, date])
}

// F6 — a branded wholesale application form. Starter = 1 form; Growth = multiple
// forms + auto-approval + file fields (PLAN_LIMITS.wholesaleFormCap). The public
// URL /apply/:shop renders the shop's default published form.
model WholesaleForm {
  id                 String                 @id @default(cuid())
  shopId             String
  shop               Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name               String
  published          Boolean                @default(false)
  isDefault          Boolean                @default(false)
  autoApproveDomains String[] // email domains that auto-approve (Growth)
  fields             WholesaleFormField[]
  applications       WholesaleApplication[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([shopId])
}

model WholesaleFormField {
  id       String             @id @default(cuid())
  formId   String
  form     WholesaleForm      @relation(fields: [formId], references: [id], onDelete: Cascade)
  label    String
  key      String // stable machine key, used in answers JSON
  type     WholesaleFieldType @default(TEXT)
  required Boolean            @default(false)
  options  Json? // for SELECT
  order    Int                @default(0)

  @@unique([formId, key])
  @@index([formId])
}

// One wholesale application. On approve it links to a Company (F5) and the
// contact becomes an admin member with a magic link.
model WholesaleApplication {
  id           String          @id @default(cuid())
  shopId       String
  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  formId       String?
  form         WholesaleForm?  @relation(fields: [formId], references: [id], onDelete: SetNull)
  companyName  String
  contactEmail String
  phone        String?
  taxId        String?
  website      String?
  answers      Json // { fieldKey: value }
  status       WholesaleStatus @default(PENDING)
  tags         String[]
  companyId    String? // set on approve (F5 Company)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([shopId, status])
  @@index([shopId, contactEmail])
}

enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
  MORE_INFO
}

enum WholesaleFieldType {
  TEXT
  EMAIL
  SELECT
  FILE
  CHECKBOX
}

// F3 — Customer-specific price lists. A named set of per-variant prices (+ volume
// breaks), assigned to companies directly or by Shopify customer tag. Buyers see
// their resolved price without discount codes. Growth unlocks unlimited lists,
// volume breaks, and CSV import; Starter is capped (see PLAN_LIMITS).
model PriceList {
  id        String             @id @default(cuid())
  shopId    String
  shop      Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  currency  String
  isDefault Boolean            @default(false)
  entries   PriceListEntry[]
  breaks    VolumeBreak[]
  companies CompanyPriceList[]
  tags      PriceListTag[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([shopId])
}

// A per-variant fixed price within a list.
model PriceListEntry {
  id                String                      @id @default(cuid())
  priceListId       String
  priceList         PriceList                   @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId         String // gid://shopify/ProductVariant/...
  price             Decimal                     @db.Decimal(18, 4)
  currencyOverrides PriceListCurrencyOverride[]

  @@unique([priceListId, variantId])
  @@index([priceListId])
}

// A quantity break within a list: at >= minQty, the unit price is `price`.
model VolumeBreak {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  minQty      Int
  price       Decimal   @db.Decimal(18, 4)

  @@unique([priceListId, variantId, minQty])
  @@index([priceListId, variantId])
}

// Assign a list to a company (one list per company).
model CompanyPriceList {
  companyId   String    @id
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@index([priceListId])
}

// Map a Shopify customer tag to a list, so new companies carrying the tag
// auto-apply the list on signup.
model PriceListTag {
  id          String    @id @default(cuid())
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tag         String
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([shopId, tag])
  @@index([priceListId])
}

// Cached wholesale cost per variant, pulled from Shopify inventoryItem.unitCost
// (needs read_inventory). Populated opportunistically when the AI Quote
// Assistant computes a suggestion, so margin math is real. Reference only — the
// authoritative money is still settled on the draft order, never computed by us.
model VariantCost {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variantId    String // gid://shopify/ProductVariant/...
  costPrice    Decimal? @db.Decimal(18, 4) // unit cost; null when Shopify has none
  currencyCode String?
  updatedAt    DateTime @updatedAt

  @@unique([shopId, variantId])
  @@index([shopId])
}

// Minimal staff-seat record — used only to gate the Starter (1) vs Growth (5)
// seat cap on the invite action. Keyed by shop; one row per invited staff email.
model StaffSeat {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([shopId, email])
  @@index([shopId])
}

model Company {
  id                String            @id @default(cuid())
  shopId            String
  shop              Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyCompanyId  String // gid://shopify/Company/...
  name              String
  approvalThreshold Decimal?          @db.Decimal(18, 4) // F5: order total that triggers approval (Growth)
  buyers            Buyer[]
  quotes            Quote[]
  reorderSources    ReorderSource[]
  creditProfile     CreditProfile?
  invoices          Invoice[]
  priceList         CompanyPriceList?
  savedOrderLists   SavedOrderList[]
  catalogAssignments CatalogAssignment[]
  repAssignments    RepAssignment[]
  taxProfile        TaxProfile?
  localePreference  LocalePreference?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([shopId, shopifyCompanyId])
  @@index([shopId])
}

// F4 — a buyer's saved order list (favourites / recurring order). Capped per
// plan (see PLAN_LIMITS.savedListCap). Reordering a list drops its items into
// the order pad.
model SavedOrderList {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  items     SavedOrderItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
}

model SavedOrderItem {
  id        String         @id @default(cuid())
  listId    String
  list      SavedOrderList @relation(fields: [listId], references: [id], onDelete: Cascade)
  variantId String // gid://shopify/ProductVariant/...
  qty       Int

  @@unique([listId, variantId])
  @@index([listId])
}

// F2 — Net Terms + Credit. One credit profile per company: a limit, default
// terms, and an active/hold status. Credit limits + status are Growth-only
// features; the profile row itself is harmless on any plan.
model CreditProfile {
  id          String       @id @default(cuid())
  companyId   String       @unique
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creditLimit Decimal      @default(0) @db.Decimal(18, 4) // 0 = no limit enforced
  termsDays   Int          @default(30) // 7|15|30|45|60|90
  status      CreditStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// F2 — an invoice raised when a net-terms order checks out. Amount + currency
// are snapshots (Shopify owns money); dueDate = issuedAt + termsDays.
model Invoice {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteId   String? // origin quote, when created from an accepted quote
  orderId   String? // gid://shopify/DraftOrder|Order/...
  amount    Decimal           @db.Decimal(18, 4)
  currency  String
  status    InvoiceStatus     @default(OPEN)
  sequenceNo Int? // F14: compliant sequential invoice number (Growth); null = legacy id-based
  issuedAt  DateTime          @default(now())
  dueDate   DateTime
  paidAt    DateTime?
  reminders PaymentReminder[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([companyId, status])
  @@index([status, dueDate])
}

// F2 — one row per reminder actually sent, so we never double-send a stage.
model PaymentReminder {
  id        String          @id @default(cuid())
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      ReminderKind
  channel   ReminderChannel @default(EMAIL)
  sentAt    DateTime        @default(now())

  @@unique([invoiceId, kind]) // idempotent: each stage sends at most once
  @@index([invoiceId])
}

enum CreditStatus {
  ACTIVE
  HOLD
}

enum InvoiceStatus {
  OPEN
  PAID
  OVERDUE
  VOID
}

enum ReminderChannel {
  EMAIL
}

enum ReminderKind {
  T_MINUS_3
  DUE
  OVERDUE_7
}

// A buyer IS a company member (F5). Roles + status live here so the existing
// passwordless magic-link invite flow is reused directly. Seat cap is per-company
// (PLAN_LIMITS.memberCap): Starter 1, Growth 5.
model Buyer {
  id                       String          @id @default(cuid())
  companyId                String
  company                  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                    String // PII
  name                     String? // PII
  role                     CompanyRole     @default(BUYER)
  status                   MemberStatus    @default(ACTIVE)
  invitedAt                DateTime?
  shopifyContactId         String? // gid://shopify/CompanyContact/...
  shopifyCompanyLocationId String? // gid://shopify/CompanyLocation/... — the location this buyer purchases for (purchasingEntity)
  magicTokenHash           String? // hash only, never raw
  magicTokenExpiresAt      DateTime?
  quotes                   Quote[]
  requestedApprovals       OrderApproval[] @relation("ApprovalRequester")
  decidedApprovals         OrderApproval[] @relation("ApprovalApprover")
  catalogAssignments       CatalogAssignment[]
  localePreference         LocalePreference?
  pushSubscriptions        PushSubscription[]
  reorderShortcuts         ReorderShortcut[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@unique([companyId, email])
  @@index([magicTokenHash])
  @@index([companyId, status])
}

enum CompanyRole {
  ADMIN
  BUYER
  APPROVER
}

enum MemberStatus {
  INVITED
  ACTIVE
}

// F5 — spending-approval record for a quote whose total ≥ the company's
// approvalThreshold. Growth-only. The order can't be placed until an approver
// approves.
model OrderApproval {
  id            String         @id @default(cuid())
  quoteId       String         @unique
  quote         Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  companyId     String
  requestedById String
  requestedBy   Buyer          @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approverId    String?
  approver      Buyer?         @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  amount        Decimal        @db.Decimal(18, 4)
  currency      String
  status        ApprovalStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?

  @@index([companyId, status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Quote {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          Buyer               @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status         QuoteStatus         @default(SUBMITTED)
  approval       OrderApproval?
  expiresAt      DateTime
  poReference    String?
  source         QuoteSource         @default(PORTAL) // F23.4: how this quote originated
  draftOrderId   String? // gid://shopify/DraftOrder/... (set on accept)
  convertedOrderId String? // F25.2: gid set by the merchant one-click convert (mirrors Offer.convertedOrderId)
  totalsSnapshot Json? // exact draftOrderCalculate output
  reminderState  Json? // F8: per-quote follow-up state ({ unsubscribed, nudgesSent, overrideCadence })
  placedByRepId  String? // F12: the sales rep who placed/negotiated this on behalf of the buyer
  placedByRep    SalesRep?           @relation("QuotePlacedByRep", fields: [placedByRepId], references: [id], onDelete: SetNull)
  displayCurrency String? // F16: buyer-facing currency locked at issue time
  displayRate    Decimal?            @db.Decimal(18, 8) // F16: FX rate (store base -> displayCurrency) locked at issue
  fromRequest    QuoteRequest?       @relation("QuoteFromRequest")
  formId         String? // F24.1: the QuoteForm the originating request used (carried on conversion)
  form           QuoteForm?          @relation("QuoteForm", fields: [formId], references: [id], onDelete: SetNull)
  lines          QuoteLine[]
  aiSuggestions  QuoteAiSuggestion[]
  followups      QuoteFollowup[]
  paymentPlan    PaymentPlan?
  payLinks       PayLink[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([companyId, status])
  @@index([status, expiresAt])
  @@index([placedByRepId])
}

// F13 — Flexible Payments. A payment plan for an accepted quote/order: full
// deposit, an installment schedule, or a one-off pay-by-link. Mannon NEVER
// stores card data — all capture runs through Shopify checkout / draft orders.
// Amounts are server-authoritative (computed in app/lib/payments.ts).
model PaymentPlan {
  id           String              @id @default(cuid())
  quoteId      String              @unique // the "order" is the accepted quote (+ its draftOrderId)
  quote        Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type         PaymentPlanType
  depositPct   Decimal?            @db.Decimal(5, 4) // fraction, e.g. 0.3000 = 30%
  schedule     Json? // snapshot of the requested schedule input (audit)
  totalAmount  Decimal             @db.Decimal(18, 4)
  currency     String
  status       PaymentPlanStatus   @default(ACTIVE)
  installments PaymentInstallment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// F13 — one scheduled payment within a plan (the deposit is installment #0).
model PaymentInstallment {
  id             String            @id @default(cuid())
  paymentPlanId  String
  paymentPlan    PaymentPlan       @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sortOrder      Int               @default(0)
  label          String?
  amount         Decimal           @db.Decimal(18, 4)
  dueDate        DateTime
  paidAt         DateTime?
  status         InstallmentStatus @default(PENDING)
  reminderStages Json? // stages already reminded (idempotent), e.g. ["DUE","OVERDUE"]
  payLinks       PayLink[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([paymentPlanId])
  @@index([status, dueDate])
}

// F13 — a tokenized, single-use, expiring pay-by-link for a specific amount.
// Only the token HASH is stored (guardrail #7); the opaque token exists only in
// the emailed URL. No amount/PII is ever placed in the URL beyond the token.
model PayLink {
  id            String              @id @default(cuid())
  quoteId       String
  quote         Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   PaymentInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  tokenHash     String              @unique
  amount        Decimal             @db.Decimal(18, 4)
  currency      String
  status        PayLinkStatus       @default(ACTIVE)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([quoteId])
  @@index([tokenHash])
}

enum PaymentPlanType {
  DEPOSIT
  INSTALLMENTS
  PAYLINK
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  OVERDUE
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum PayLinkStatus {
  ACTIVE
  PAID
  EXPIRED
}

// F8 — a scheduled follow-up for a quote (reminder nudge, expiry warning, or the
// expiry itself). The scheduler dispatches due rows and cancels the rest when a
// quote is accepted/rejected.
model QuoteFollowup {
  id           String          @id @default(cuid())
  quoteId      String
  quote        Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind         FollowupKind
  scheduledFor DateTime
  sentAt       DateTime?
  channel      FollowupChannel @default(EMAIL)
  status       FollowupStatus  @default(SCHEDULED)
  createdAt    DateTime        @default(now())

  @@index([quoteId])
  @@index([status, scheduledFor])
}

enum FollowupKind {
  REMINDER
  EXPIRY_WARNING
  EXPIRED
}

enum FollowupChannel {
  EMAIL
}

enum FollowupStatus {
  SCHEDULED
  SENT
  CANCELLED
}

model QuoteLine {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variantId String // gid://shopify/ProductVariant/...
  sku       String?
  title     String // snapshot for display
  quantity  Int
  price     Decimal  @db.Decimal(18, 4) // buyer-proposed or countered unit price
  createdAt DateTime @default(now())

  @@index([quoteId])
}

// AI Quote Assistant (Feature 1, Growth-only). One row per suggestion the
// merchant generated for a quote — line-level (lineId set) or quote-level
// (lineId null). The most recent row per (quoteId, lineId) is the cached
// suggestion shown on the page. AI drafts only; a human confirms (guardrail #4).
model QuoteAiSuggestion {
  id             String   @id @default(cuid())
  quoteId        String
  quote          Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lineId         String? // null = quote-level suggestion
  suggestedPrice Decimal  @db.Decimal(18, 4)
  floorPrice     Decimal  @db.Decimal(18, 4)
  marginPct      Float? // null when the variant has no cached cost (unknown margin)
  belowFloor     Boolean  @default(false) // snapshot: did the suggestion breach the floor?
  rationale      String // plain-English reasoning shown to the merchant
  draftMessage   String // ready-to-send buyer message
  model          String // e.g. claude-haiku-4-5
  createdAt      DateTime @default(now())

  @@index([quoteId, lineId, createdAt])
}

model ReorderSource {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shopifyOrderId String // gid://shopify/Order/...
  orderName      String // e.g. #1042
  orderedAt      DateTime
  total          String // snapshot string, paired with currency
  currency       String
  createdAt      DateTime @default(now())

  @@unique([companyId, shopifyOrderId])
  @@index([companyId])
}

// F20 — White-Label / Agency Multi-Store Management. An Organization groups
// several Mannon stores under one agency/brand for cross-store rollups and
// light white-labeling. Management-only metadata — it never moves money and
// never crosses per-store data isolation (every store query is keyed by shop).
// Growth-only (Agency add-on); dark-launched behind MANNON_FF_WHITE_LABEL.
model Organization {
  id         String      @id @default(cuid())
  name       String
  ownerEmail String
  stores     OrgStore[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// A store's membership in an org, with a per-store role. `shop` is the store's
// shopifyDomain. A store belongs to at most one org (shop @unique).
model OrgStore {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shop      String // shopifyDomain
  role      OrgRole  @default(MANAGER)
  createdAt DateTime @default(now())

  @@unique([shop])
  @@index([orgId])
}

enum OrgRole {
  OWNER
  MANAGER
  VIEWER
}

// F20 — per-store white-label overrides for BUYER-FACING pages only (portal +
// emails). Never affects the embedded Shopify admin (stays Mannon/Polaris).
// Colors are validated for AA contrast before they're stored.
model Branding {
  id           String   @id @default(cuid())
  shop         String   @unique // shopifyDomain
  logoFileId   String? // gid://shopify/... (optional hosted logo)
  primaryColor String? // hex, overrides indigo on the portal
  accentColor  String? // hex, overrides lime on the portal
  portalName   String? // replaces "Mannon" wording on buyer pages
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// APPEND-ONLY. Written only via app/services/events.server.ts insert helper.
model Event {
  id         String    @id @default(cuid())
  shopId     String
  shop       Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type       EventType
  entityType String // "Quote" | "Buyer" | "ReorderSource" | ...
  entityId   String?
  payload    Json? // NO PII in payload — ids + numbers only
  createdAt  DateTime  @default(now())

  @@index([shopId, type, createdAt])
}

enum Plan {
  TRIAL
  STARTER // $29
  GROWTH // $79
  CANCELLED
}

enum QuoteStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  ORDERED
  EXPIRED
}

// F23.4 — how a quote originated (feeds source analytics). PORTAL is the default
// buyer path; DUPLICATE (F25.4) and IMPORT (F25.3) are merchant-side.
enum QuoteSource {
  PORTAL
  WIDGET
  REP
  DUPLICATE
  IMPORT
}

enum EventType {
  APP_INSTALLED
  QUOTE_SUBMITTED
  QUOTE_COUNTERED
  QUOTE_ACCEPTED
  QUOTE_ORDERED
  QUOTE_EXPIRED
  REORDER_CREATED
  DRAFT_ORDER_CREATED
  AI_PARSE_ACCEPTED
  AI_SUGGESTION_USED
  INVOICE_CREATED
  REMINDER_SENT
  CREDIT_OVERRIDE
  PRICELIST_ASSIGNED
  ORDERPAD_USED
  MEMBER_INVITED
  ORDER_APPROVED
  WHOLESALE_APPLICATION_DECIDED
  ANALYTICS_VIEWED
  FOLLOWUP_SENT
  ORDER_RULE_APPLIED
  ACCOUNTING_CONNECTED
  INVOICE_SYNCED
  CATALOG_ASSIGNED
  REP_INVITED
  ORDER_PLACED_ON_BEHALF
  PAYMENT_PLAN_CREATED
  INSTALLMENT_PAID
  PAYLINK_PAID
  TAX_PROFILE_VERIFIED
  ERP_CONNECTED
  STOCK_SYNCED
  ORDER_EXPORTED
  LOCALE_CHANGED
  QUOTE_REQUEST_CREATED
  PWA_INSTALLED
  REORDER_ONECLICK
  PUBLIC_CATALOG_PUBLISHED
  CATALOG_LEAD_CREATED
  ORG_CREATED
  STORE_LINKED
  BRANDING_UPDATED
  TRIAL_STARTED
  PLAN_UPGRADED
  PLAN_CANCELLED
  REVIEW_PROMPT_SHOWN
  QUOTE_FORM_UPDATED
  PRICE_RULE_UPDATED
  QUOTE_CONVERTED
  QUOTE_PDF_GENERATED
  QUOTE_DUPLICATED
}
